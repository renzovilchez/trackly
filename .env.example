# ============================================
# Trackly — Environment Variables
# ============================================
# Copia este archivo como .env y completa los valores

# Connection string de Neon (obligatorio)
# 1. Crea una cuenta gratuita en https://neon.tech
# 2. Crea un proyecto y copia el connection string
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/trackly?sslmode=require

# Salt para hashear direcciones IP (obligatorio)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_SALT=cambia-esto-por-un-valor-aleatorio-seguro
